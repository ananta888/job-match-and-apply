{
  "contract": "agent-provider-support",
  "contractVersion": "1.0",
  "policyVersion": "2026-08-17",
  "unknownVersionPolicy": "block",
  "securityDefaultChangePolicy": "explicit_contract_major_and_user_migration",
  "deprecation": {
    "minimumNoticeDays": 90,
    "emergencySecurityNoticeDays": 0,
    "removalRequiresReplacementOrDocumentedNoFallback": true
  },
  "experimentalTransports": {
    "selection": "requirement-driven",
    "mustDegradeToStableTransport": true,
    "mustFailClosedOnHealthOrIsolationDoubt": true,
    "mustBeServerOwned": true,
    "mustBeVisibleInApiAndUi": true,
    "mayNotBroadenSandboxOrApprovalDefaults": true,
    "mayNotRequireAnOperatorToggle": true
  },
  "securityDefaultChanges": [
    {
      "date": "2026-08-17",
      "change": "retired the CODEX_APP_SERVER_EXPERIMENTAL opt-in and features.codexAppServerExperimental",
      "replaces": "experimentalDefault:false",
      "rationale": "An operator toggle gated the transport rather than the risk. Because the app-server transport offers dynamic tools it can never carry the server-owned zero-tools contract, so the toggle silently disabled a finished feature: with it on, cv-ai structuring reported provider_zero_tools_not_supported and no Codex installation was usable at all. Containment is now structural instead of optional.",
      "containment": [
        "selection follows the requirements of each run, not a flag",
        "a run needing the zero-tools contract is always served by the stable codex exec transport",
        "an unallowlisted provider version degrades to codex exec",
        "unverified user-config isolation and failed pre-turn health checks still fail closed and never degrade",
        "the chosen transport, the app-server availability and the reason for not choosing it are reported in provider capabilities"
      ],
      "userMigration": "agent config profile schema 2 to 3 drops the retired field on load",
      "sandboxOrApprovalDefaultsChanged": false
    }
  ],
  "providers": [
    {
      "id": "codex-exec",
      "adapterVersion": "1.0.0",
      "protocolVersion": "1.0",
      "status": "supported",
      "testedVersionPatterns": ["^(?:codex-cli|codex)\\s+0\\.147\\.0$"],
      "fixture": "contracts/fixtures/v1/codex-exec-events.json",
      "runtimeTargets": ["windows", "wsl", "linux", "darwin"],
      "experimental": false,
      "supportedProfiles": ["read_only_or_workspace_write_offline"],
      "promptTransport": "stdin",
      "networkControl": true,
      "offlineConfigOverrides": [
        "sandbox_workspace_write.network_access=false",
        "web_search=\"disabled\""
      ],
      "networkEnforcement": "codex-cli-0.147.0-fixed-offline-config-v1",
      "networkMechanism": "server-owned-config-plus-codex-sandbox-policy",
      "networkAccessClaim": "provider-control-plane-only",
      "sandboxBoundary": "codex-cli-sandbox-policy-0.147.0",
