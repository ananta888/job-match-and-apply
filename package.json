{
  "name": "job-match-and-apply",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm --prefix server run dev\" \"npm --prefix web start\"",
    "build": "npm --prefix server run build && npm --prefix web run build",
    "test": "npm run test:repository-scripts && npm --prefix server test && npm --prefix web test -- --watch=false",
    "test:repository-scripts": "node --test scripts/*.test.mjs",
    "test:security-scan": "node --test scripts/security-scan.test.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "mail:server": "npm --prefix server run mail:server",
    "agent:mcp": "npm --prefix server run agent:mcp",
    "job-mcp:smoke": "npm --prefix server run job-mcp:smoke --",
    "agent:fake": "node scripts/fake-agent.mjs",
    "setup:integrations": "powershell -ExecutionPolicy Bypass -File scripts/setup-integrations.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
