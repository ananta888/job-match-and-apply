{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/job-match-and-apply/contracts/v1/agent-run.schema.json",
  "title": "AgentRun v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "provider", "state", "request", "requestedAt", "updatedAt", "currentSequence"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "state": {
      "enum": ["queued", "starting", "running", "waiting_for_input", "waiting_for_approval", "cancelling", "cancelled", "succeeded", "failed", "timed_out", "orphaned", "recovering"]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "task", "workspaceRoot", "runtimeTarget", "sandbox", "network", "approvalMode"],
      "properties": {
        "provider": { "type": "string" },
        "task": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "runtimeTarget": { "enum": ["windows", "wsl", "linux", "darwin", "container"] },
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
        "network": { "enum": ["disabled", "restricted", "enabled"] },
        "approvalMode": { "enum": ["deny", "explicit"] },
        "applicationCaseId": { "type": "string", "format": "uuid" }
      }
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "currentSequence": { "type": "integer", "minimum": 0 },
    "queuePosition": { "type": "integer", "minimum": 0 }
  }
}
