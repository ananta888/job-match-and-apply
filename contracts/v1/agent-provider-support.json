{
  "contract": "agent-provider-support",
  "contractVersion": "1.0",
  "policyVersion": "2026-08-14",
  "unknownVersionPolicy": "block",
  "securityDefaultChangePolicy": "explicit_contract_major_and_user_migration",
  "deprecation": {
    "minimumNoticeDays": 90,
    "emergencySecurityNoticeDays": 0,
    "removalRequiresReplacementOrDocumentedNoFallback": true
  },
  "featureFlags": {
    "experimentalDefault": false,
    "mustBeServerOwned": true,
    "mustBeVisibleInApiAndUi": true,
    "mayNotBroadenSandboxOrApprovalDefaults": true
  },
  "providers": [
    {
      "id": "codex-exec",
      "adapterVersion": "1.0.0",
      "protocolVersion": "1.0",
      "status": "supported",
      "testedVersionPatterns": ["^(?:codex-cli|codex)\\s+0\\.147\\.0$"],
      "fixture": "contracts/fixtures/v1/codex-exec-events.json",
      "runtimeTargets": ["windows", "wsl", "linux", "darwin"],
      "experimental": false,
      "supportedProfiles": ["read_only_or_workspace_write_offline"],
      "promptTransport": "stdin",
      "networkControl": true,
      "offlineConfigOverrides": [
        "sandbox_workspace_write.network_access=false",
        "web_search=\"disabled\""
      ],
      "networkEnforcement": "codex-cli-0.147.0-fixed-offline-config-v1",
      "networkMechanism": "server-owned-config-plus-codex-sandbox-policy",
      "networkAccessClaim": "provider-control-plane-only"
    },
    {
      "id": "codex-app-server",
      "adapterVersion": "0.1.0",
      "protocolVersion": "1.0",
      "status": "experimental",
      "testedVersionPatterns": ["^(?:codex-cli|codex)\\s+0\\.147\\.0$"],
      "fixture": "contracts/fixtures/v1/codex-app-server-events.json",
      "runtimeTargets": ["windows", "wsl", "linux", "darwin"],
      "experimental": true,
      "featureFlag": "CODEX_APP_SERVER_EXPERIMENTAL",
      "productionSelection": "native_run_local_codex_home_with_pre_turn_fallback",
      "userConfigIsolation": "ephemeral-codex-home-auth-only",
      "dynamicToolsContract": "codex-app-server-item-tool-call-v1",
      "networkControl": true,
      "offlineConfigOverrides": [
        "sandbox_workspace_write.network_access=false",
        "web_search=\"disabled\""
      ],
      "networkEnforcement": "codex-cli-0.147.0-fixed-offline-config-v1",
      "networkMechanism": "server-owned-config-plus-codex-sandbox-policy",
      "networkAccessClaim": "provider-control-plane-only",
      "fallback": "codex-exec-before-first-turn-only"
    },
    {
      "id": "opencode",
      "adapterVersion": "1.1.0",
      "protocolVersion": "1.0",
      "status": "supported",
      "testedVersionPatterns": ["^1\\.14\\.41$"],
      "fixture": "contracts/fixtures/v1/opencode-events.json",
      "runtimeTargets": ["wsl"],
      "experimental": false,
      "sandboxBoundary": "wsl-bubblewrap-v1",
      "supportedProfiles": ["read_only_agent_tools_offline"],
      "promptTransport": "stdin",
      "approvalMode": "deny",
      "resume": false,
      "pause": false,
      "networkEnforcement": "provider-tool-capability-policy",
      "networkAccessClaim": "provider-control-plane-only"
    },
    {
      "id": "claude-cli",
      "adapterVersion": "1.1.0",
      "protocolVersion": "1.0",
      "status": "supported",
      "testedVersionPatterns": ["^2\\.1\\.232 \\(Claude Code\\)$"],
      "fixture": "contracts/fixtures/v1/claude-cli-events.json",
      "runtimeTargets": ["wsl"],
      "experimental": false,
      "sandboxBoundary": "wsl-bubblewrap-v1",
      "supportedProfiles": ["read_only_agent_tools_offline"],
      "promptTransport": "stdin",
      "approvalMode": "deny",
      "resume": false,
      "pause": false,
      "networkEnforcement": "provider-tool-capability-policy",
      "networkAccessClaim": "provider-control-plane-only"
    }
  ],
  "upgradeChecklist": [
    "capture_synthetic_no_secret_fixture",
    "replay_known_and_unknown_events",
    "verify_fixed_argv_and_prompt_transport",
    "verify_sandbox_and_network_effective_policy",
    "verify_approval_defaults_unchanged",
    "run_secret_pii_canaries",
    "run_cancel_timeout_output_and_recovery_tests",
    "record_exact_tested_version_pattern",
    "show_support_state_and_limitations_in_api_and_ui"
  ]
}
